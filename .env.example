# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Nothing here is required to run `python -m argus.ledger`; keys only gate the
# OBSERVE layer in argus/sources/.

# --- free and instant to obtain ---------------------------------------------

# FRED — Fed plumbing, rates, credit spreads (argus/sources/macro.py).
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a real contact address or it
# blocks you. Format: "Name email@example.com".
EDGAR_IDENTITY=

# Sent as the User-Agent on every outbound request in argus/sources/base.py.
# Several government APIs reject generic agents. Include a contact address.
ARGUS_USER_AGENT=ARGUS/0.2 (research; you@example.com)

# Congress.gov — legislation pipeline for the policy domain.
# https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# --- paid or gated -----------------------------------------------------------

# RWA.xyz — tokenized-Treasury AUM by issuer, the adoption-curve proxy
# (argus/sources/tokenization.py). Reported as SKIP by check_sources if unset.
RWA_XYZ_API_KEY=

# Kalshi — only needed for authenticated endpoints; public market reads work
# without it (argus/sources/prediction_markets.py).
KALSHI_API_KEY=

# Financial Modeling Prep — market data.
FMP_API_KEY=

# --- optional overrides ------------------------------------------------------
# ARGUS_CACHE_DIR=.cache          # on-disk response cache (gitignored)
# ARGUS_CACHE_TTL=3600            # default cache lifetime, seconds
# ARGUS_LEDGER_PATH=data/ledger/predictions.jsonl
